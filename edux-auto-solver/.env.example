# =============================================================================
# CẤU HÌNH KẾT NỐI CÔNG CỤ AI CODING (KHÔNG CẦN GEMINI API KEY)
# =============================================================================
# AI_PROVIDER:
#   - auto        : Tự động ưu tiên Antigravity (agy) -> OpenAI Codex (codex) -> Claude (claude) -> OpenCode
#   - antigravity : Chỉ dùng Google Antigravity CLI (agy)
#   - codex       : Chỉ dùng OpenAI Codex CLI (codex exec)
#   - claude      : Chỉ dùng Claude Code CLI (claude -p)
#   - opencode    : Chỉ dùng OpenCode CLI (opencode run)
AI_PROVIDER=auto
AI_MODEL=gemini-3.8-flash-low
AI_EFFORT=low
